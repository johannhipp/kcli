#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
	printf '\n==> %s\n' "$1"
}

step "Checking system prerequisites"
missing=()
for command_name in curl git make python3 tar; do
	if ! command -v "$command_name" >/dev/null 2>&1; then
		missing+=("$command_name")
	fi
done

if ((${#missing[@]})); then
	if [[ "$(uname -s)" != "Linux" ]] || ! command -v apt-get >/dev/null 2>&1; then
		printf 'Missing required commands: %s\n' "${missing[*]}" >&2
		exit 1
	fi

	apt=(apt-get)
	if ((EUID != 0)); then
		apt=(sudo apt-get)
	fi
	"${apt[@]}" update
	"${apt[@]}" install -y ca-certificates curl git make python3 tar
fi

required_go="$(awk '$1 == "toolchain" { sub(/^go/, "", $2); print $2; exit }' go.mod)"
if [[ -z "$required_go" ]]; then
	required_go="$(awk '$1 == "go" { print $2; exit }' go.mod)"
fi
required_go_label="go${required_go}"

install_go() {
	local architecture archive checksum filename install_parent install_root metadata temp_dir
	case "$(uname -m)" in
		x86_64) architecture=amd64 ;;
		aarch64 | arm64) architecture=arm64 ;;
		*) printf 'Unsupported architecture: %s\n' "$(uname -m)" >&2; return 1 ;;
	esac

	if [[ "$(uname -s)" != "Linux" ]]; then
		printf 'Automatic Go installation is supported only in Linux orbs.\n' >&2
		return 1
	fi

	metadata="$(python3 - "$required_go_label" "$architecture" <<'PY'
import json
import sys
import urllib.request

version, architecture = sys.argv[1:]
with urllib.request.urlopen("https://go.dev/dl/?mode=json&include=all", timeout=30) as response:
    releases = json.load(response)
for release in releases:
    if release["version"] != version:
        continue
    for file in release["files"]:
        if file["os"] == "linux" and file["arch"] == architecture and file["kind"] == "archive":
            print(file["filename"], file["sha256"])
            raise SystemExit
raise SystemExit(f"No official archive found for {version} linux/{architecture}")
PY
)"
	read -r filename checksum <<<"$metadata"

	archive="$HOME/.cache/kcli-orb/$filename"
	mkdir -p "$(dirname "$archive")"
	if [[ ! -f "$archive" ]]; then
		curl --fail --location --retry 3 --output "$archive" "https://go.dev/dl/$filename"
	fi
	python3 - "$archive" "$checksum" <<'PY'
import hashlib
import pathlib
import sys

archive, expected = pathlib.Path(sys.argv[1]), sys.argv[2]
actual = hashlib.sha256(archive.read_bytes()).hexdigest()
if actual != expected:
    archive.unlink(missing_ok=True)
    raise SystemExit(f"Checksum mismatch for {archive.name}")
PY

	install_parent="$HOME/.local/share/kcli-orb"
	install_root="$install_parent/$required_go_label"
	mkdir -p "$install_parent"
	if [[ ! -x "$install_root/bin/go" ]]; then
		temp_dir="$(mktemp -d "$install_parent/.go-install.XXXXXX")"
		trap 'rm -rf -- "$temp_dir"' RETURN
		tar -C "$temp_dir" -xzf "$archive"
		rm -rf -- "$install_root"
		mv "$temp_dir/go" "$install_root"
		rm -rf -- "$temp_dir"
		trap - RETURN
	fi
	export PATH="$install_root/bin:$PATH"
}

step "Activating Go $required_go"
if ! command -v go >/dev/null 2>&1 ||
	[[ "$(GOTOOLCHAIN=auto go version 2>/dev/null || true)" != "go version $required_go_label "* ]]; then
	install_go
fi

go_root="$(GOTOOLCHAIN=auto go env GOROOT)"
export PATH="$go_root/bin:$PATH"
if [[ "$(go version)" != "go version $required_go_label "* ]]; then
	printf 'Expected Go %s, got %s\n' "$required_go" "$(go version)" >&2
	exit 1
fi

active_go_bin="$(cd "$(dirname "$(command -v go)")" && pwd -P)"
expected_go_bin="$(cd "$go_root/bin" && pwd -P)"
if [[ "$active_go_bin" != "$expected_go_bin" ]]; then
	printf 'Unable to activate Go from %s\n' "$expected_go_bin" >&2
	exit 1
fi

if [[ ":${PATH}:" != *":${go_root}/bin:"* ]]; then
	printf 'Unable to add Go to PATH\n' >&2
	exit 1
fi

env_file="$HOME/.config/kcli-orb/env.sh"
profile_marker="# kcli orb Go toolchain"
mkdir -p "$(dirname "$env_file")"
{
	printf '# Generated by %s/.agents/setup.\n' "$repo_root"
	printf 'export PATH=%q/bin:$PATH\n' "$go_root"
} >"$env_file"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
	{
		printf '\n%s\n' "$profile_marker"
		printf 'source %q\n' "$env_file"
	} >>"$HOME/.bash_profile"
fi

step "Downloading Go module dependencies"
go mod download
go mod verify

step "Warming pinned lint tools"
go mod download honnef.co/go/tools@v0.8.1 golang.org/x/vuln@v1.7.0
go run honnef.co/go/tools/cmd/staticcheck@v0.8.1 -version
go run golang.org/x/vuln/cmd/govulncheck@v1.7.0 -version

step "Warming the build cache"
go build ./...

printf '\nOrb setup complete with %s.\n' "$(go version)"
